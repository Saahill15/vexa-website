{
  "name": "vexa-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "make-admin": "node --env-file-if-exists=.env.local scripts/make-admin.mjs",
    "gmail-authorize": "node scripts/gmail-authorize.mjs",
    "test:mail": "tsc lib/gmail.ts --outDir .test-build --module commonjs --target es2022 --moduleResolution node --skipLibCheck --esModuleInterop --types node && node scripts/test-gmail.mjs",
    "db:schema": "node --env-file-if-exists=.env.local scripts/db.mjs schema",
    "db:import-json": "node --env-file-if-exists=.env.local scripts/db.mjs import-json",
    "make-admin:prod": "node --env-file-if-exists=.env.production scripts/make-admin.mjs",
    "db:schema:prod": "node --env-file-if-exists=.env.production scripts/db.mjs schema",
    "db:import-json:prod": "node --env-file-if-exists=.env.production scripts/db.mjs import-json"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "lenis": "^1.3.27",
    "motion": "^14.5.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
