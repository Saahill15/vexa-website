# Copy to .env (or .env.local while developing). Never commit a filled .env.

# --- Accounts -----------------------------------------------------------------------------------
# Google sign-in. Create an OAuth client of type "Web application" at console.cloud.google.com
# (APIs and Services > Credentials), add your site address under "Authorised JavaScript origins"
# (for example https://www.vexadigital.in and http://localhost:3310), and paste its Client ID here.
# No client secret is needed. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Comma-separated emails that become admins when they sign in with Google (the address must be Google-verified).
# The very first admin can also be made with:  npm run make-admin -- you@example.com
ADMIN_EMAILS=

# The public address of the site, no trailing slash. REQUIRED in production: links in account emails are built from it,
# never from the request, so nobody can get a reset link that points at another site.
SITE_URL=

# A long random string that signs login cookies, for example from: openssl rand -base64 48
# If empty, one is generated once and kept in the data folder.
SESSION_SECRET=

# --- Contact form -------------------------------------------------------------------------------
# Where each enquiry is also sent: the n8n flow that emails the VEXA inbox.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# --- Database --------------------------------------------------------------------------------
# PostgreSQL connection string. Local: a Docker container. Production: PostgreSQL on the server.
# Create the schema with: npm run db:schema
# Local development and scripts. On Cloudflare the Worker uses the Hyperdrive binding instead (docs/cloudflare.md).
DATABASE_URL=

# Folder for the session secret when SESSION_SECRET is empty (and for the old JSON import). Defaults to ./data.
VEXA_DATA_DIR=

# Account email through Resend (verification and password reset links)
RESEND_API_KEY=
MAIL_FROM=Vexa Digital <no-reply@mail.vexadigital.in>
# Optional fallback if RESEND_API_KEY is empty
ACCOUNT_MAIL_WEBHOOK_URL=
ACCOUNT_MAIL_WEBHOOK_TOKEN=

# Admin mail inbox (partnerships@, support@, contact@). See docs/gmail-inbox.md.
# GMAIL_AUTH=oauth
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Written by: npm run gmail-authorize
GMAIL_OAUTH_REFRESH_TOKEN=
