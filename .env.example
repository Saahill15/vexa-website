# Copy to .env on the server (/opt/vexa/site/.env). Never commit a filled .env.
NEXTAUTH_URL=https://www.vexadigital.in
# A long random string, for example from: openssl rand -base64 32
NEXTAUTH_SECRET=
# Staff two-step sign-in (docs/admin/ADMIN.md). Required for every admin and moderator unless set to false
# (a temporary rollout escape hatch only; staff who have enrolled must always pass the code).
STAFF_TOTP_REQUIRED=true
# Required in production: encrypts staff authenticator keys. At least 32 characters, separate from
# NEXTAUTH_SECRET, for example from: openssl rand -base64 32. Back it up with the database backups.
STAFF_TOTP_KEY=
# Only while rotating STAFF_TOTP_KEY: the old key, still accepted for reading. Remove once rotation is done.
STAFF_TOTP_KEY_PREVIOUS=
# Use the existing website public web client ID for Google Identity Services.
# Enable at runtime only after its production JavaScript origin is configured.
# No client secret is needed for the signed ID-token flow.
GOOGLE_IDENTITY_ENABLED=false
GOOGLE_CLIENT_ID=
# Legacy redirect provider only; ignored when GOOGLE_IDENTITY_ENABLED=true.
GOOGLE_CLIENT_SECRET=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Private transactional mail webhook (existing n8n/Gmail sender).
ACCOUNT_MAIL_WEBHOOK_URL=
ACCOUNT_MAIL_WEBHOOK_TOKEN=
VEXA_DATA_DIR=/app/data
# Set only after ingress overwrites X-Real-IP and prevents direct access.
VEXA_TRUST_PROXY=0
